# NativeWind v4 (engine react-native-css-interop) menetapkan react-native &
# react-native-reanimated sebagai peer dependency. Pada npm 7+ peer-deps
# di-auto-install: tanpa setelan ini npm menarik reanimated v4 + RN 0.86
# (nested di node_modules/nativewind) yang TIDAK kompatibel dgn Expo SDK 52
# (RN 0.76) dan mematahkan bundling Metro. legacy-peer-deps mematikan
# auto-install tsb; peer dipenuhi oleh dependensi top-level (RN 0.76.9,
# reanimated 3.16.x). WAJIB juga berlaku saat EAS build (npm baca .npmrc ini).
legacy-peer-deps=true
